# Sameer AI Workspace
# Keep secrets server-side. Never commit real values.

# Composio project API key used by the first-class app connectors.
# Create/manage this in your Composio Platform project.
COMPOSIO_API_KEY=

# Vercel Sandbox credentials used for isolated code execution.
# On Vercel deployments, VERCEL_OIDC_TOKEN may be provided automatically when OIDC is enabled.
# Alternatively set VERCEL_TOKEN with VERCEL_TEAM_ID and VERCEL_PROJECT_ID.
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional AI provider keys already used by the workspace.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OMNIROUTE_API_KEY=
OMNIROUTE_URL=

# Optional workspace services.
SMTP_USER=
SMTP_PASS=
INTERNAL_API_SECRET=
