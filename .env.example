# Sameer AI Workspace — direct first-party connector OAuth
# Keep these values server-side. Never commit a real secret.

# Required in production for encrypted connector session cookies.
CONNECTOR_ENCRYPTION_SECRET=

# Google OAuth (Gmail, Google Drive, Google Calendar, YouTube)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Microsoft 365 OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# The redirect URI to register with each provider is:
# https://claude-enterprise-app.vercel.app/api/connectors/oauth/callback
