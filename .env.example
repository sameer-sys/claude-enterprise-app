# Sameer AI Workspace — Composio-only connector runtime
# Keep secrets server-side. Do not commit real values.

# Composio uses the For You MCP session; no project API key is required.

# Optional AI provider keys already used by the workspace.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Composio OAuth callback:
# https://claude-enterprise-app.vercel.app/api/composio/callback

# GitHub Remote MCP OAuth (create a GitHub OAuth App; keep secret server-side)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Canonical public origin of this deployment, no trailing slash.
# Required in production. The OAuth callback (${APP_URL}/api/mcp/oauth/callback)
# is built from this so client registration, authorization, and token exchange
# all send one identical redirect_uri. Must match the Authorization callback URL
# registered on the GitHub OAuth App exactly, or GitHub returns
# "The redirect_uri is not associated with this application."
APP_URL=https://claude-enterprise-app.vercel.app
